# Copy to .env.local for local dev, and set the same values in your hosting
# provider's environment variables (Vercel: Project Settings > Environment
# Variables) for every environment you deploy.

# PostHog project token. NEXT_PUBLIC_* vars are inlined at BUILD time, so a
# deploy that is missing this silently ships with analytics disabled - and you
# have to redeploy, not just save the variable, for a change to take effect.
# NEXT_PUBLIC_POSTHOG_KEY is accepted as a legacy alias.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used by the server-side client in lib/posthog-server.ts. The browser talks to
# PostHog through the /ingest proxy in next.config.mjs instead.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Speech generation. route.ts rotates across whichever of these are set.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
